# Environment: development | production
ENV=development

# Database (required in production)
DATABASE_URL=postgresql://user:password@localhost:5432/shreeomjwellers

# JWT (required in production; use a long random string)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# Cookie domain (set to your production domain, not localhost)
COOKIE_DOMAIN=localhost

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Media storage
MEDIA_STORAGE_PATH=./media

# Public base URL for uploaded media
PUBLIC_BASE_URL=http://localhost:8000

# Path to the built frontend (dist) directory, if serving the SPA from this backend
FRONTEND_DIST_PATH=../frontend/dist